PORT=5000
# "memory" = built-in local database saved in server/.data (no Atlas or MongoDB install needed).
# For Atlas use: mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/athlete_system?retryWrites=true&w=majority
MONGO_URI=memory
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
